# --- WordPress (backend headless) ---
WP_URL=https://admin.mkaraks.com
# Secret partagé avec le plugin WP "mkaraks-headless" (même valeur que MKARAKS_HEADLESS_SECRET dans wp-config.php)
WP_HEADLESS_SECRET=change-me-long-random
# Secret du webhook de revalidation (appelé par WordPress à chaque modification)
REVALIDATE_SECRET=change-me-too

# --- Session (cookie httpOnly signé) ---
# openssl rand -base64 48
SESSION_SECRET=

# --- Bucket GCS privé ---
GCS_BUCKET=mkaraksbucket
# Préfixe des fichiers CHIFFRÉS produits par scripts/encrypt-bucket.mjs
GCS_PREFIX=enc/
# Compte de service avec le rôle "Lecteur des objets Storage" sur le bucket
GCS_CLIENT_EMAIL=mkaraks-signer@PROJECT.iam.gserviceaccount.com
# Clé privée du JSON du compte de service (les \n littéraux sont acceptés)
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Chiffrement des médias ---
# Clé maîtresse 32 octets en base64 : openssl rand -base64 32
# NE JAMAIS LA CHANGER après chiffrement du bucket (sinon tout est illisible).
MEDIA_MASTER_KEY=

# Durée de validité des téléchargements hors ligne sans reconnexion (jours)
OFFLINE_KEY_DAYS=30
